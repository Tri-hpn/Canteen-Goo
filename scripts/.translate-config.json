{
  "sourceLang": "vi",
  "targetLangs": ["en", "ja", "ko", "zh"],
  "minLength": 2,
  "delayMs": 150,
  "maxRetries": 3,
  "skipPatterns": [
    "^[\\p{Emoji}\\s\\p{P}]+$",
    "^\\d+$",
    "^https?://",
    "^\\{[a-z_]+\\}$"
  ],
  "protectPatterns": [
    "\\{[^}]+\\}",
    "https?://\\S+",
    "\\*\\*[^*]+\\*\\*"
  ]
}