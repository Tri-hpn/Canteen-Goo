# ============================================================
# Dockerfile.backend — Backend (Express + JSON DB)
# ============================================================
# Build:  docker build -f Dockerfile.backend -t canteen-backend .
# Run:    docker run -p 3000:3000 -e JWT_SECRET=xxx canteen-backend
# ============================================================

FROM node:20-alpine

WORKDIR /app

# Install dumb-init để handle signals đúng (SIGTERM, SIGINT)
RUN apk add --no-cache dumb-init

# Copy package files trước để cache
COPY package*.json ./

# Cài dependencies — chỉ production
RUN npm ci --omit=dev && npm cache clean --force

# Copy backend source + DB seed
COPY server-json.js ./
COPY canteen-db.json ./

# Tạo user non-root để bảo mật
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 && \
    chown -R nodejs:nodejs /app

USER nodejs

# Expose port
EXPOSE 3000

# Env defaults (có thể override khi docker run)
ENV NODE_ENV=production
ENV PORT=3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/api/health || exit 1

# Chạy với dumb-init để forward signals
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "server-json.js"]