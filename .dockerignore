# ============================================================
# .dockerignore — Loại file không cần copy vào Docker image
# ============================================================

# Dependencies (sẽ npm install trong container)
node_modules
**/node_modules

# Build output (sẽ build trong container)
dist
build
dist-ssr

# Environment
.env
.env.*
!.env.example

# Git
.git
.gitignore
.gitattributes

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs
npm-debug.log*

# Docker
Dockerfile
Dockerfile.*
.dockerignore
docker-compose*.yml

# Test & coverage
coverage
.nyc_output

# Docs
README.md
CHANGELOG.md
LICENSE
docs

# Cache
.cache
.vite
.parcel-cache

# Deploy configs
.vercel
.netlify
render.yaml

# Backup
*.backup
*.backup.json
backup-*.json

# Local DB (không dùng trong production container)
canteen-db.local.json