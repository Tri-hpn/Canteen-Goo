# ============================================================
# .env.example — Template cho team
# ============================================================
# Cách dùng:
#   1. cp .env.example .env
#   2. Điền giá trị thật vào .env
#   3. KHÔNG commit .env
# ============================================================

# ---------- Frontend (Vite) ----------
# Dev: để trống → Vite proxy /api → localhost:3000
# Prod: URL backend (VD: https://canteen-api.onrender.com/api)
VITE_API_URL=

# ---------- Backend (Express) ----------
NODE_ENV=development
PORT=3000

# ---------- Security ----------
# JWT secret — BẮT BUỘC đổi trước khi deploy production
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_strong_random_string

# ---------- Optional ----------
# CORS_ORIGIN=http://localhost:5173
# MAX_UPLOAD_SIZE=5242880
# DB_PATH=./canteen-db.json
# RATE_LIMIT_MAX=100
# ---------- Frontend (Vite) ----------
VITE_API_URL=

# ---------- Holiday API (Gravitee Gateway) ----------
# ⚠️ Các biến này nhúng vào bundle FE — chỉ dùng cho internal/demo
# Nếu là production, nên proxy qua backend
VITE_HOLIDAY_API_URL=
VITE_GRAVITEE_API_KEY=
VITE_GRAVITEE_SECRET_KEY=